# ── lookkool storefront ───────────────────────────────────────────────
# The storefront runs entirely on bundled mock data with NO config.
# Fill these in once you deploy a MedusaJS v2 backend to go live.

# Base URL of your Medusa server, e.g. https://api.lookkool.com
NEXT_PUBLIC_MEDUSA_BACKEND_URL=

# Publishable API key from the Medusa admin (Settings → Publishable keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# (Optional) the US sales region id for correct pricing/currency
NEXT_PUBLIC_MEDUSA_REGION_ID=
